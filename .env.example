# ==============================
# DATABASE CONFIGURATION
# ==============================

# PostgreSQL connection string
# Format:
# postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ev_india


# ==============================
# OPENCHARGEMAP API
# ==============================

# Required for data collection
OPENCHARGE_API_KEY=your_opencharge_api_key_here


# ==============================
# DATA PIPELINE SETTINGS
# ==============================

# Maximum records fetched per API call
MAX_RESULTS=500

# Comma-separated country codes
# For India-only dataset use: IN
# Example for multiple: IN,US,CA
COUNTRY_CODES=IN

# Scheduler frequency (in hours)
UPDATE_INTERVAL_HOURS=24


# ==============================
# BACKEND API SETTINGS
# ==============================

API_HOST=127.0.0.1
API_PORT=8000


# ==============================
# FRONTEND CONFIGURATION
# ==============================

REACT_APP_API_URL=http://127.0.0.1:8000